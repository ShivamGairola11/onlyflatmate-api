# NestJS API. Copy to .env for local development (values below are the Supabase CLI's local defaults).
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Server-only. In production use the project's secret key from the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=
# Local / legacy HS256 projects only. Cloud projects with signing keys verify via JWKS and leave this empty.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Address search + reverse lookup via Geoapify (free key at geoapify.com; restrict it to this server's IP).
GEOAPIFY_API_KEY=
# Road routing (defaults are free public servers; self-host or use a paid one in production)
ROUTER_URLS=https://routing.openstreetmap.de/routed-car,https://router.project-osrm.org
ROUTER_TIMEOUT_MS=4000
# Contact Pass checkout: mock (dev only) | razorpay
# Razorpay (required when PAYMENTS_PROVIDER=razorpay). Dashboard → Account & Settings → API Keys.
# Use rzp_test_… keys until you go live. The key secret is server-only.
PAYMENTS_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → Add: URL https://<your-site>/api/webhooks/razorpay, event payment.captured, and a secret of your choosing.
RAZORPAY_WEBHOOK_SECRET=
# Transactional email (work-email verification codes) via resend.com. Without a key, dev logs codes; production returns 503.
RESEND_API_KEY=
EMAIL_FROM=FindFlatmates <verify@findflatmates.in>
# Public web app origin, used for links in emails (e.g. the Contact Pass renew link).
WEB_URL=https://www.findflatmates.in
# Shared secret with the web app's BFF (same value there). With it set, the API answers nobody else (404),
# so a leaked API address exposes nothing. Required in production (NODE_ENV=production refuses to start without it).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY=
# Set NODE_ENV=production on the server: it enforces INTERNAL_API_KEY and refuses PAYMENTS_PROVIDER=mock.

# Deletes listings nobody has confirmed for 30 days (hourly). Default on; set off for local dev so dated seed data survives.
# LISTING_CLEANUP=off
